name: Deploy

on:
  push:
    branches: [main]

jobs:
  test:
    uses: ./.github/workflows/ci.yml
  build:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
      - name: Log in to ghcr.io
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Set up Buildx
        uses: docker/setup-buildx-action@v4
      - name: Build
        uses: docker/build-push-action@v7
        with:
          context: .
          load: true
          tags: ghcr.io/jakoblui-works/{{ service_name }}:{% raw %}${{ github.sha }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Smoke test image
        run: >
          docker run --rm \
            -e REDIS__PASSWORD=x \
            -e DATABASE__PASSWORD=x \
{%- if use_s3 %}
            -e S3__ACCESS_KEY_ID=x \
            -e S3__SECRET_ACCESS_KEY=x \
            -e S3__BUCKET=x \
{%- endif %}
            ghcr.io/jakoblui-works/{{ service_name }}:{% raw %}${{ github.sha }}{% endraw %} \
            python -u -c 'import importlib, pkgutil, app; [print(m.name) or importlib.import_module(m.name) for m in pkgutil.walk_packages(app.__path__, "app.")]'
      - name: Push
        uses: docker/build-push-action@v7
        with:
          context: .
          push: true
          tags: |
            ghcr.io/jakoblui-works/{{ service_name }}:{% raw %}${{ github.sha }}{% endraw %}
            ghcr.io/jakoblui-works/{{ service_name }}:latest
          cache-from: type=gha
      - name: Trigger deploy
        env:
          GH_TOKEN: {% raw %}${{ secrets.DEPLOY_REPO_DISPATCH_TOKEN }}{% endraw %}
        run: |
          gh api repos/jakoblui-works/infra/dispatches -f event_type=deploy
